# Tempo — environment variable reference (exhaustive, value-less).
# Copy to `.env` locally; set real values in Vercel per environment.
# NEVER commit real secrets. Keep this file in sync with actual env usage.
# Full matrix + rationale: docs/09-deployment-vercel.md, docs/03-backend-fastapi.md.

# ─────────────────────────────────────────────────────────────────────────────
# apps/api  (tempo-api — FastAPI: REST + /mcp + /oauth/* + /.well-known/*)
# ─────────────────────────────────────────────────────────────────────────────

# Database (Neon). App uses the POOLED URL; Alembic/seed use the UNPOOLED (direct) URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Test-only: base URL of a throwaway Postgres (local or a Neon test branch — NEVER prod).
# The DB name is ignored; the suite creates/drops its own databases from this server.
# Defaults to postgresql://postgres:postgres@localhost:5432/postgres when unset.
TEST_DATABASE_URL=

# Canonical origins / OAuth issuer (build all absolute URLs from these).
# e.g. https://api.tempo.clupai.com
PUBLIC_BASE_URL=
# e.g. https://api.tempo.clupai.com
OAUTH_ISSUER=
# e.g. https://tempo.clupai.com  (CORS allowlist + post-login redirect target)
WEB_ORIGIN=
# Optional: extra CORS origins (comma-separated), e.g. stable Vercel preview URLs.
CORS_EXTRA_ORIGINS=
# App log level (DEBUG|INFO|WARNING|ERROR). Defaults to INFO.
LOG_LEVEL=
# e.g. tempo.clupai.com  (parent-domain session cookie reaches both subdomains)
SESSION_COOKIE_DOMAIN=

# Secrets (generate with `openssl rand -hex 32`).
SESSION_SIGNING_KEY=
TOKEN_HASH_PEPPER=

# Google OIDC (end-user login is delegated to Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# e.g. https://api.tempo.clupai.com/oauth/callback/google
GOOGLE_REDIRECT_URI=

# OAuth client redirect allowlist (comma-separated hosts), incl. claude.ai.
# Defaults to "claude.ai,claude.com" when unset.
ALLOWED_REDIRECT_HOSTS=

# Optional auth/OAuth lifetimes + DCR rate cap (all have sane defaults; override to tune).
# Web session TTL (sliding); default 604800 (7d).
SESSION_TTL_SECONDS=
# Authorization code TTL; spec requires ≤60. Default 60.
AUTH_CODE_TTL_SECONDS=
# Access token TTL; default 3600 (1h).
ACCESS_TOKEN_TTL_SECONDS=
# Refresh token TTL (rotated on use); default 5184000 (60d).
REFRESH_TOKEN_TTL_SECONDS=
# Max /oauth/register calls per rolling minute (abuse backstop); default 20.
OAUTH_REGISTRATION_RATE_LIMIT_PER_MINUTE=

# MCP server (Streamable-HTTP at /mcp). The transport validates the Host (and, when present,
# Origin) header against an allowlist (DNS-rebinding defense). The public API host + localhost
# are always allowed; list extra hosts/origins (comma-separated) for previews or other clients.
# All optional — sane defaults. Disable the check only for a diagnostic (default true).
MCP_DNS_REBINDING_PROTECTION=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Vercel Blob (exercise illustrations).
BLOB_READ_WRITE_TOKEN=

# OpenAI images (GPT Image 2 — on-demand endpoint; batch jobs run offline in scripts/).
OPENAI_API_KEY=
# Pinned model id, e.g. gpt-image-2 (gpt-image-1 retires 2026-10-23 — do not use). Default gpt-image-2.
OPENAI_IMAGE_MODEL=
# Image size (default 1024x1024) and quality (low|medium|high — default low). Defaults suit
# the locked minimal line-art style.
OPENAI_IMAGE_SIZE=
OPENAI_IMAGE_QUALITY=
# Background: opaque|auto — default opaque. GPT Image 2 REJECTS "transparent" (HTTP 400,
# "Transparent background is not supported for this model"), so the prompt asks for a flat
# magenta key field and app/images/chroma.py strips it to real alpha after generation. The
# stored asset is still a transparent PNG. Do not set this to "transparent".
OPENAI_IMAGE_BACKGROUND=

# ─────────────────────────────────────────────────────────────────────────────
# apps/web  (tempo-web — Next.js)
# ─────────────────────────────────────────────────────────────────────────────

# e.g. https://tempo.clupai.com
NEXT_PUBLIC_BASE_URL=
# e.g. https://api.tempo.clupai.com  (browser fetches)
NEXT_PUBLIC_API_URL=
# API origin for server-side (RSC) fetches; usually the same public API URL.
API_INTERNAL_URL=
