# Environment (never commit real secrets; keep .env.example current)
# Deny-by-default: every .env variant is ignored, then .env.example is re-included.
# The old explicit list missed .env.production / .env.development, which are real
# secret-bearing files — a deny-list here is one forgotten suffix away from a leak.
.env*
!.env.example

# Vercel
.vercel/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/
